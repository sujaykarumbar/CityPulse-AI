CITYPULSE_APP_NAME=CityPulse API
CITYPULSE_ENVIRONMENT=local
CITYPULSE_LOG_LEVEL=INFO
CITYPULSE_API_PREFIX=/api/v1
CITYPULSE_LLM_PROVIDER=
CITYPULSE_LLM_MODEL=
CITYPULSE_LLM_API_KEY=
CITYPULSE_LLM_BASE_URL=
CITYPULSE_LLM_TEMPERATURE=0
CITYPULSE_LLM_MAX_TOKENS=800
CITYPULSE_MLFLOW_TRACKING_URI=
CITYPULSE_MLFLOW_ARTIFACT_URI=
CITYPULSE_MLOPS_DATABASE_URL=
CITYPULSE_PROMETHEUS_URL=
CITYPULSE_GRAFANA_URL=
CITYPULSE_MODEL_REGISTRY_PATH=artifacts/mlops
CITYPULSE_DRIFT_MONITORING_ENABLED=true
CITYPULSE_RETRAINING_ENABLED=true
CITYPULSE_STREAM_BROKER_URL=
CITYPULSE_STREAM_BROKER_PROVIDER=local_file_compatibility
CITYPULSE_STREAMING_ENABLED=false
CITYPULSE_REDIS_URL=
CITYPULSE_PROMETHEUS_ENABLED=false
CITYPULSE_POSTGRES_PASSWORD=replace-with-local-only-password
CITYPULSE_GRAFANA_ADMIN_PASSWORD=replace-with-local-only-password
